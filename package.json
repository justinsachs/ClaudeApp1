{
  "name": "ai-course-platform",
  "version": "1.0.0",
  "description": "AI-powered course deployment platform with NotebookLM, Sora, and HeyGen integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --watch src --ext ts --exec ts-node src/server/server.ts",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/server/db/drizzle/migrate.ts",
    "db:migrate:prod": "node dist/db/drizzle/migrate.js",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "test": "jest"
  },
  "keywords": [
    "ai",
    "education",
    "course",
    "learning",
    "notebooklm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.8.2",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.7",
    "redis": "^5.10.0",
    "sqlite3": "^5.1.6",
    "tsx": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.30",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.8",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
