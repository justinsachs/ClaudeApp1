# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/courses.db

# AI Service API Keys (Add your actual keys here)
NOTEBOOKLM_API_KEY=your_notebooklm_key_here
SORA_API_KEY=your_sora_key_here
HEYGEN_API_KEY=your_heygen_key_here

# Chatbot for Calibration Interviews
# Choose provider: 'openai' or 'anthropic'
CHATBOT_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# File Upload & Storage
MAX_FILE_SIZE=10485760

# Storage Configuration
# Options: 'local', 's3', 'r2'
STORAGE_TYPE=local

# Local Storage (for development/EC2)
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_LOCAL_URL=http://localhost:3000/uploads

# S3 Storage (for AWS)
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://your-cdn-url.com

# Cloudflare R2 Storage (for Cloudflare)
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_PUBLIC_URL=https://your-r2-public-url.com

# Redis (for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
