# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://{{ db_user | default('app_user') }}:{{ db_password | default('changeme123') }}@localhost:5432/{{ db_name | default('ai_course_platform') }}

# AI Service API Keys
NOTEBOOKLM_API_KEY={{ notebooklm_api_key }}
SORA_API_KEY={{ sora_api_key }}
HEYGEN_API_KEY={{ heygen_api_key }}

# Chatbot for Calibration Interviews
CHATBOT_PROVIDER={{ chatbot_provider | default('openai') }}
OPENAI_API_KEY={{ openai_api_key }}
ANTHROPIC_API_KEY={{ anthropic_api_key | default('') }}

# File Upload & Storage
MAX_FILE_SIZE=10485760

# Storage Configuration
STORAGE_TYPE={{ storage_type | default('s3') }}

{% if storage_type == 's3' %}
# S3 Storage
S3_BUCKET={{ s3_bucket_name }}
S3_REGION={{ aws_region }}
S3_ACCESS_KEY_ID={{ s3_access_key_id }}
S3_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
S3_PUBLIC_URL={{ s3_public_url }}
{% elif storage_type == 'local' %}
# Local Storage
STORAGE_LOCAL_PATH={{ app_dir }}/data/uploads
STORAGE_LOCAL_URL=https://{{ domain_name }}/uploads
{% endif %}

# Redis
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port | default('6379') }}
